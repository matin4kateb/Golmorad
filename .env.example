# Runtime settings
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Tehran

# Local SQLite database. Relative paths are resolved from the project root.
DATABASE_PATH=Database/golmorad.db

# Bitcoin market-data collection (Yahoo Finance symbol and yfinance intervals)
MARKET_SYMBOL=BTC-USD
MARKET_INTERVALS=1d,1h
DATA_REFRESH_INTERVAL_SECONDS=900
DATA_HTTP_TIMEOUT_SECONDS=20

# Comma-separated RSS/Atom feeds. Articles are filtered for Bitcoin/BTC mentions.
NEWS_RSS_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/

# Bit24 API credentials. Add your own credentials locally; never commit them.
# API key is used for authenticated requests; API secret is needed for signed requests.
BIT24_API_KEY=
BIT24_API_SECRET=

# Bit24 REST client settings
BIT24_BASE_URL=https://rest.bit24.cash
BIT24_TIMEOUT_SECONDS=15
BIT24_MAX_REQUESTS_PER_MINUTE=250
