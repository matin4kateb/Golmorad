# Runtime settings
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Tehran

# Local SQLite database. Relative paths are resolved from the project root.
DATABASE_PATH=Database/golmorad.db

# Bit24 API credentials. Add your own credentials locally; never commit them.
# API key is used for authenticated requests; API secret is needed for signed requests.
BIT24_API_KEY=
BIT24_API_SECRET=

# Bit24 REST client settings
BIT24_BASE_URL=https://rest.bit24.cash
BIT24_TIMEOUT_SECONDS=15
BIT24_MAX_REQUESTS_PER_MINUTE=250